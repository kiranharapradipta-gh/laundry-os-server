generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// LAUNDRYOS - COMPLETE SAAS DATABASE SCHEMA
// PostgreSQL
// ============================================================================
//
// DOMAIN MAP
//
// SaaS
//   Business -> Subscription -> Plan
//
// Identity / RBAC
//   User -> BusinessMember -> Role -> Permission
//
// Organization
//   Business -> Branch -> Department
//   Branch -> Employee -> Shift
//
// CRM
//   Customer -> Address / Tag / Segment / Activity / Loyalty
//
// Catalog
//   ServiceCategory -> Service -> ServicePrice
//   AddOn
//   Tax / Discount / Voucher
//
// Orders / POS
//   Order -> OrderItem -> OrderItemAddOn
//   OrderStatusHistory
//   OrderPayment
//   Receipt / Invoice
//
// Production
//   ProductionBatch -> ProductionTask
//   Machine -> MachineUsage
//
// Storage
//   StorageLocation -> OrderStorage
//
// Inventory
//   InventoryItem -> StockTransaction
//   Supplier -> PurchaseOrder -> PurchaseOrderItem
//   StockTransfer
//
// Finance
//   CashRegister -> CashSession -> CashMovement
//   Expense -> ExpenseCategory
//   Account / JournalEntry / JournalLine
//
// Delivery
//   DeliveryOrder -> DeliveryStatusHistory
//   DeliveryDriver / DeliveryRoute
//
// Customer Care
//   Complaint -> ComplaintMessage
//
// Communication
//   Notification / NotificationTemplate
//   WhatsAppMessage / EmailMessage / SMSMessage
//
// Platform
//   APIKey / Webhook / Integration / AuditLog
//   FileAsset / SystemSetting / FeatureFlag
//
// ============================================================================

// ============================================================================
